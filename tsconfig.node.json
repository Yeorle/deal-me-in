{
  "compilerOptions": {
    // Typecheck-only (run as `tsc -p tsconfig.node.json --noEmit`): composite
    // projects are emit-capable, and `tsc -b` would litter the repo root with
    // compiled vite.config.js/.d.ts.
    "noEmit": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true
  },
  "include": ["vite.config.ts", "vitest.config.ts"]
}
